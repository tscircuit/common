{
  "name": "@tscircuit/common",
  "version": "0.0.56",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tscircuit"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "npm run build:lib",
    "build:lib": "tsup-node --format esm ./index.tsx && tsc -p tsconfig.build.json",
    "prepare": "bun run build:lib",
    "build:circuit": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update --3d",
    "start": "bunx tsci dev",
    "footprints:check": "bun run scripts/replace-jlcpcb-footprints.ts",
    "footprints:update": "bun run scripts/replace-jlcpcb-footprints.ts --write",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@tscircuit/footprinter": "^0.0.394",
    "@types/react": "^19.1.12",
    "circuit-json-to-footprinter": "^0.0.21",
    "tscircuit": "^0.0.2242",
    "tsup": "^8.5.0"
  }
}
